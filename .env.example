# Alpaca paper keys (required) — from https://app.alpaca.markets/paper/dashboard/overview
# Paper keys start with PK
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Jev / AI Gateway key (one of these, or neither for mock mode)
# Normal route: Vercel AI Gateway (no waitlist, card on file required)
AI_GATEWAY_API_KEY=
# Optional: direct TypeSafe key (faster, higher rate limit, waitlist)
TYPESAFE_API_KEY=

# Default symbol if --symbol not passed (any Alpaca crypto pair or US equity ticker)
DEFAULT_SYMBOL=BTC/USD

# Jev throttle tuning (defaults shown, lower only with a direct TYPESAFE_API_KEY)
JEV_MIN_INTERVAL_S=4
JEV_MIN_GAP_S=3
JEV_MATERIAL_MOVE_BPS=15
JEV_MAX_JUDGMENT_AGE_S=60

# Live trading gate (leave blank for paper — required exact string to enable live)
# JEV_LOOP_ALLOW_LIVE=i-understand-the-risk
